	ДобавитьПараметр(Параметры, "ОснованиеПолномочийРуководителяКонтрагентаПередающего", НСтр("ru = 'Основание полномочий руководителя передающего'"), "Передающий");

	ДобавитьПараметр(Параметры, "КонтрагентПринимающий",                          НСтр("ru = 'Принимающий (кратко)'"),                    "Принимающий");
