	ДобавитьПараметр(Параметры, "ИННКонтрагентаПринимающего",                     НСтр("ru = 'ИНН принимающего'"),                        "Принимающий");
	ДобавитьПараметр(Параметры, "КППКонтрагентаПринимающего",                     НСтр("ru = 'КПП принимающего'"),                        "Принимающий");
	ДобавитьПараметр(Параметры, "ОГРНКонтрагентаПринимающего",                    НСтр("ru = 'ОГРН принимающего'"),                       "Принимающий");
	ДобавитьПараметр(Параметры, "ЮридическийАдресКонтрагентаПринимающего",        НСтр("ru = 'Юридический адрес принимающего'"),          "Принимающий");
	ДобавитьПараметр(Параметры, "ТелефонКонтрагентаПринимающего",                 НСтр("ru = 'Телефон принимающего'"),                    "Принимающий");
	ДобавитьПараметр(Параметры, "РуководительКонтрагентаПринимающего",            НСтр("ru = 'Руководитель принимающего'"),               "Принимающий");
	ДобавитьПараметр(Параметры, "ДолжностьРуководителяКонтрагентаПринимающего",   НСтр("ru = 'Должность руководителя принимающего'"),     "Принимающий");
	ДобавитьПараметр(Параметры, "ПредставительКонтрагентаПринимающего",           НСтр("ru = 'Представитель принимающего (должность, ФИО)'"), "Принимающий");
	ДобавитьПараметр(Параметры, "ОснованиеПолномочийРуководителяКонтрагентаПринимающего", НСтр("ru = 'Основание полномочий руководителя принимающего'"), "Принимающий");

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значение параметра шаблона по имени.
//
// Параметры:
//   ИмяПараметра - Строка - имя параметра без скобок, регистр не важен
//   СведенияОбАкте - Структура - см. СведенияОбАкте()
//   Успешно - Булево - выходный: Ложь, если параметр не найден
//
// Возвращаемое значение:
//   Строка - значение для подстановки в шаблон
//
Функция ЗначениеПараметра(ИмяПараметра, СведенияОбАкте, Успешно)

	Имя = ВРег(СокрЛП(ИмяПараметра));
	Успешно = Истина;

	Если Имя = "НОМЕРДОКУМЕНТА" Тогда
		Возврат СведенияОбАкте.НомерДокумента;

	ИначеЕсли Имя = "ДАТАДОКУМЕНТА" Тогда
		Возврат Формат(СведенияОбАкте.ДатаДокумента, "ДЛФ=D");

	ИначеЕсли Имя = "АВТОР" Тогда
		Возврат СведенияОбАкте.Автор;

	ИначеЕсли Имя = "КОЛИЧЕСТВОПРОДУКТОВ" Тогда
		Возврат Формат(СведенияОбАкте.Продукты.Количество(), "ЧГ=");

	ИначеЕсли Имя = "ПЕРЕДАВАЕМЫЕПРОДУКТЫ" Тогда
		Возврат СтрСоединить(СведенияОбАкте.Продукты, Символы.ПС);

	ИначеЕсли Имя = "ОРГАНИЗАЦИЯ" Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.СокращенноеНаименование;

	ИначеЕсли СтрНачинаетсяС(Имя, "ПОЛНОЕНАИМЕНОВАНИЕОРГАНИЗАЦИИ") Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.ПолноеНаименование;

	ИначеЕсли СтрНачинаетсяС(Имя, "ИНН") И СтрЗаканчиваетсяНа(Имя, "ОРГАНИЗАЦИИ") Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.ИНН;

	ИначеЕсли СтрНачинаетсяС(Имя, "КПП") И СтрЗаканчиваетсяНа(Имя, "ОРГАНИЗАЦИИ") Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.КПП;

	ИначеЕсли СтрНачинаетсяС(Имя, "ОГРН") И СтрЗаканчиваетсяНа(Имя, "ОРГАНИЗАЦИИ") Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.ОГРН;

	ИначеЕсли Имя = "ЮРИДИЧЕСКИЙАДРЕСОРГАНИЗАЦИИ" Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.ЮридическийАдрес;

	ИначеЕсли Имя = "ТЕЛЕФОНОРГАНИЗАЦИИ" Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.Телефоны;

	ИначеЕсли Имя = "РУКОВОДИТЕЛЬОРГАНИЗАЦИИ" Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.РуководительФИО;

	ИначеЕсли Имя = "ДОЛЖНОСТЬРУКОВОДИТЕЛЯОРГАНИЗАЦИИ" Тогда
		Возврат СведенияОбАкте.СведенияОбОрганизации.ДолжностьРуководителяПредставление;

	Иначе
		Возврат ЗначениеПараметраКонтрагента(Имя, СведенияОбАкте.СведенияОПередающем, "ПЕРЕДАЮЩЕГО",
			СведенияОбАкте.СведенияОПринимающем, "ПРИНИМАЮЩЕГО", Успешно);

	КонецЕсли;

КонецФункции

// Возвращает значение параметра контрагента (передающего или принимающего).
Функция ЗначениеПараметраКонтрагента(Имя, СведенияОПередающем, СуффиксПередающего,
		СведенияОПринимающем, СуффиксПринимающего, Успешно)

	Если СтрЗаканчиваетсяНа(Имя, СуффиксПередающего) Тогда
		Сведения = СведенияОПередающем;
		Суффикс = СуффиксПередающего;
	ИначеЕсли СтрЗаканчиваетсяНа(Имя, СуффиксПринимающего) Тогда
		Сведения = СведенияОПринимающем;
		Суффикс = СуффиксПринимающего;
	Иначе
		Успешно = Ложь;
		Возврат ПрочеркДляНезаполненногоПараметра();
	КонецЕсли;

	Если Имя = "КОНТРАГЕНТ" + Суффикс Тогда
		Возврат Сведения.СокращенноеНаименование;

	ИначеЕсли Имя = "ПОЛНОЕНАИМЕНОВАНИЕКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.ПолноеНаименование;

	ИначеЕсли Имя = "ИННКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.ИНН;

	ИначеЕсли Имя = "КППКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.КПП;

	ИначеЕсли Имя = "ОГРНКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.ОГРН;

	ИначеЕсли Имя = "ЮРИДИЧЕСКИЙАДРЕСКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.ЮридическийАдрес;

	ИначеЕсли Имя = "ТЕЛЕФОНКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.Телефоны;

	ИначеЕсли Имя = "РУКОВОДИТЕЛЬКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.РуководительФИО;

	ИначеЕсли Имя = "ДОЛЖНОСТЬРУКОВОДИТЕЛЯКОНТРАГЕНТА" + Суффикс Тогда
		Возврат Сведения.ДолжностьРуководителяПредставление;

	ИначеЕсли Имя = "ПРЕДСТАВИТЕЛЬКОНТРАГЕНТА" + Суффикс Тогда
		Если ЗначениеЗаполнено(Сведения.ДолжностьРуководителяПредставление)
			И ЗначениеЗаполнено(Сведения.РуководительФИО) Тогда
			Возврат Сведения.ДолжностьРуководителяПредставление + " " + Сведения.РуководительФИО;
		Иначе
			Возврат Сведения.РуководительФИО;
		КонецЕсли;

	ИначеЕсли Имя = "ОСНОВАНИЕПОЛНОМОЧИЙРУКОВОДИТЕЛЯКОНТРАГЕНТА" + Суффикс Тогда
		Возврат ОснованиеПолномочийРуководителя(Сведения);

	Иначе
		Успешно = Ложь;
		Возврат ПрочеркДляНезаполненногоПараметра();

	КонецЕсли;

КонецФункции

// Основание полномочий руководителя: у юридического лица - Устав,
// у индивидуального предпринимателя - свидетельство о регистрации.
Функция ОснованиеПолномочийРуководителя(Сведения)

	Если Сведения.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат НСтр("ru = 'свидетельства о государственной регистрации физического лица в качестве индивидуального предпринимателя'");
	КонецЕсли;

	Возврат НСтр("ru = 'Устава'");

КонецФункции

