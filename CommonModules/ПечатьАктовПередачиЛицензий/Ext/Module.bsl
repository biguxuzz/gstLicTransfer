// Формирование печатной формы акта приема-передачи лицензий по шаблону
// из справочника ШаблоныПередачиЛицензий.
//
// Принцип повторяет типовой механизм печати договоров
// (Справочник.ШаблоныДоговоров + ПечатьДоговоров):
//  - шаблон хранится в реквизите ШаблонХранилище (ХранилищеЗначения)
//    как структура {ТекстHTML, Вложения};
//  - параметры в тексте шаблона записываются в фигурных скобках {ИмяПараметра}
//    и выделяются желтым фоном;
//  - при заполнении параметры заменяются значениями, фон снимается;
//  - незаполненные параметры остаются выделенными.

#Область ПрограммныйИнтерфейс

// Возвращает структуру параметров заполнения текста акта.
//
// Возвращаемое значение:
//   Структура:
//     * СсылкаНаОбъект - ДокументСсылка.ПередачаЛицензий - печатаемый документ
//     * ШаблонАкта     - СправочникСсылка.ШаблоныПередачиЛицензий - шаблон печати
//
Функция СтруктураПараметровПечатиАкта() Экспорт

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("СсылкаНаОбъект", Неопределено);
	ПараметрыЗаполнения.Вставить("ШаблонАкта", Неопределено);

	Возврат ПараметрыЗаполнения;

КонецФункции

// Заполняет форматированный документ текстом акта по шаблону:
// загружает HTML шаблона и заменяет параметры {ИмяПараметра} на значения реквизитов.
//
// Параметры:
//   ПараметрыЗаполнения - Структура - см. СтруктураПараметровПечатиАкта()
//   ФорматированныйДокумент - ФорматированныйДокумент - заполняемый документ
//
Процедура ЗаполнитьТекстАкта(ПараметрыЗаполнения, ФорматированныйДокумент) Экспорт

	СведенияОбАкте = СведенияОбАкте(ПараметрыЗаполнения.СсылкаНаОбъект);
	Если СведенияОбАкте = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеШаблона = Справочники.ШаблоныПередачиЛицензий.ДанныеШаблона(ПараметрыЗаполнения.ШаблонАкта);
	Если ПустаяСтрока(ДанныеШаблона.ТекстHTML) Тогда
		Возврат;
	КонецЕсли;

	ФорматированныйДокумент.УстановитьHTML(ДанныеШаблона.ТекстHTML, ДанныеШаблона.Вложения);

	ЦветФонаПараметра = ЦветФонаЗаменяемогоПараметра();
	ЦветПоУмолчанию = Новый Цвет(255, 255, 255);

	ОбластьНачалоПараметра = ФорматированныйДокумент.НайтиТекст("{");
	Пока ОбластьНачалоПараметра <> Неопределено Цикл

		ОбластьКонецПараметра = ФорматированныйДокумент.НайтиТекст("}", ОбластьНачалоПараметра.ЗакладкаНачала);
		Если ОбластьКонецПараметра = Неопределено Тогда
			// Нет закрывающей скобки - параметр продолжается до конца текста.
			Прервать;
		КонецЕсли;

		МассивЭлементов = ФорматированныйДокумент.СформироватьЭлементы(
			ОбластьНачалоПараметра.ЗакладкаНачала, ОбластьКонецПараметра.ЗакладкаКонца);

		// Из-за форматирования текст параметра может быть разбит на несколько
		// элементов - собираем в одну строку.
		ИмяПараметра = "";
		Для Каждого ЭлементДокумента Из МассивЭлементов Цикл
			Если ТипЗнч(ЭлементДокумента) = Тип("ТекстФорматированногоДокумента") Тогда
				ИмяПараметра = ИмяПараметра + ЭлементДокумента.Текст;
			КонецЕсли;
		КонецЦикла;

		ИмяПараметра = СтрЗаменить(ИмяПараметра, "{", "");
		ИмяПараметра = СтрЗаменить(ИмяПараметра, "}", "");

		Успешно = Истина;
		Если ЗначениеЗаполнено(ИмяПараметра) Тогда
			Значение = ЗначениеПараметра(ИмяПараметра, СведенияОбАкте, Успешно);
		Иначе
			Значение = "";
		КонецЕсли;

		// Значение подставляем в первый текстовый элемент,
		// остальные текстовые элементы параметра очищаем.
		Подставлено = Ложь;
		ЭлементЗначения = Неопределено;
		Для Каждого ЭлементДокумента Из МассивЭлементов Цикл
			Если ТипЗнч(ЭлементДокумента) <> Тип("ТекстФорматированногоДокумента") Тогда
				Продолжить;
			КонецЕсли;
			Если Не Подставлено Тогда
				ЭлементДокумента.Текст = Значение;
				Подставлено = Истина;
				ЭлементЗначения = ЭлементДокумента;
			Иначе
				ЭлементДокумента.Текст = "";
			КонецЕсли;
		КонецЦикла;

		Если Успешно И ЭлементЗначения <> Неопределено Тогда
			Если ЭлементЗначения.ЦветФона = ЦветФонаПараметра Тогда
				ЭлементЗначения.ЦветФона = ЦветПоУмолчанию;
			КонецЕсли;
		КонецЕсли;

		// Ищем следующий параметр.
		ОбластьНачалоПараметра = ФорматированныйДокумент.НайтиТекст("{", ОбластьНачалоПараметра.ЗакладкаНачала);

	КонецЦикла;

КонецПроцедуры

// Возвращает сведения об акте и сторонах для подстановки в шаблон.
//
// Параметры:
//   СсылкаНаОбъект - ДокументСсылка.ПередачаЛицензий - печатаемый документ
//
// Возвращаемое значение:
//   Структура:
//     * НомерДокумента - Строка
//     * ДатаДокумента - Дата
//     * Автор - Строка - представление автора
//     * СведенияОбОрганизации - Структура - см. БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице()
//     * СведенияОПередающем - Структура - аналогично, по контрагенту передающему
//     * СведенияОПринимающем - Структура - аналогично, по контрагенту принимающему
//     * Продукты - Массив из Строка - строки "1. Продукт, регистрационный номер: ХХХ"
//
Функция СведенияОбАкте(СсылкаНаОбъект) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПередачаЛицензий.Номер КАК Номер,
	|	ПередачаЛицензий.Дата КАК Дата,
	|	ПередачаЛицензий.Организация КАК Организация,
	|	ПередачаЛицензий.КонтрагентПередающий КАК КонтрагентПередающий,
	|	ПередачаЛицензий.КонтрагентПринимающий КАК КонтрагентПринимающий,
	|	ПередачаЛицензий.Автор КАК Автор,
	|	ПередачаЛицензий.ПередаваемыеПродукты.(
	|		НомерСтроки,
	|		Продукт,
	|		РегистрационныйНомер
	|	) КАК ПередаваемыеПродукты
	|ИЗ
	|	Документ.ПередачаЛицензий КАК ПередачаЛицензий
	|ГДЕ
	|	ПередачаЛицензий.Ссылка = &Ссылка");

	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сведения = Новый Структура;
	Сведения.Вставить("НомерДокумента", Выборка.Номер);
	Сведения.Вставить("ДатаДокумента", Выборка.Дата);
	Сведения.Вставить("Автор", Строка(Выборка.Автор));

	Сведения.Вставить("СведенияОбОрганизации",
		БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Выборка.Организация, Выборка.Дата));
	Сведения.Вставить("СведенияОПередающем",
		БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Выборка.КонтрагентПередающий, Выборка.Дата));
	Сведения.Вставить("СведенияОПринимающем",
		БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Выборка.КонтрагентПринимающий, Выборка.Дата));

	Продукты = Новый Массив;
	ВыборкаПродуктов = Выборка.ПередаваемыеПродукты.Выбрать();
	Пока ВыборкаПродуктов.Следующий() Цикл
		СтрокаПродукта = Формат(ВыборкаПродуктов.НомерСтроки, "ЧГ=") + ". "
			+ СокрЛП(ВыборкаПродуктов.Продукт);
		Если ЗначениеЗаполнено(ВыборкаПродуктов.РегистрационныйНомер) Тогда
			СтрокаПродукта = СтрокаПродукта
				+ ", регистрационный номер: " + СокрЛП(ВыборкаПродуктов.РегистрационныйНомер);
		КонецЕсли;
		Продукты.Добавить(СтрокаПродукта);
	КонецЦикла;
	Сведения.Вставить("Продукты", Продукты);

	Возврат Сведения;

КонецФункции

// Возвращает список параметров шаблона для редактора шаблонов.
//
// Возвращаемое значение:
//   ТаблицаЗначений с колонками:
//     * Имя - Строка - имя параметра без скобок
//     * Представление - Строка - представление для пользователя
//     * Группа - Строка - имя группы параметров
//
Функция ТаблицаПараметровШаблона() Экспорт

	Параметры = Новый ТаблицаЗначений;
	Параметры.Колонки.Добавить("Имя");
	Параметры.Колонки.Добавить("Представление");
	Параметры.Колонки.Добавить("Группа");

	ДобавитьПараметр(Параметры, "НомерДокумента",            НСтр("ru = 'Номер документа'"),                 "Документ");
	ДобавитьПараметр(Параметры, "ДатаДокумента",             НСтр("ru = 'Дата документа'"),                  "Документ");
	ДобавитьПараметр(Параметры, "Автор",                     НСтр("ru = 'Автор документа'"),                 "Документ");
	ДобавитьПараметр(Параметры, "КоличествоПродуктов",       НСтр("ru = 'Количество продуктов'"),            "Документ");
	ДобавитьПараметр(Параметры, "ПередаваемыеПродукты",      НСтр("ru = 'Список передаваемых продуктов'"),   "Документ");

	ДобавитьПараметр(Параметры, "Организация",                       НСтр("ru = 'Организация (кратко)'"),                        "Организация");
	ДобавитьПараметр(Параметры, "ПолноеНаименованиеОрганизации",     НСтр("ru = 'Организация (полное наименование)'"),          "Организация");
	ДобавитьПараметр(Параметры, "ИННОрганизации",                    НСтр("ru = 'ИНН организации'"),                             "Организация");
	ДобавитьПараметр(Параметры, "КППОрганизации",                    НСтр("ru = 'КПП организации'"),                             "Организация");
	ДобавитьПараметр(Параметры, "ОГРНОрганизации",                   НСтр("ru = 'ОГРН организации'"),                            "Организация");
	ДобавитьПараметр(Параметры, "ЮридическийАдресОрганизации",       НСтр("ru = 'Юридический адрес организации'"),               "Организация");
	ДобавитьПараметр(Параметры, "ТелефонОрганизации",                НСтр("ru = 'Телефон организации'"),                         "Организация");
	ДобавитьПараметр(Параметры, "РуководительОрганизации",           НСтр("ru = 'Руководитель организации'"),                    "Организация");
	ДобавитьПараметр(Параметры, "ДолжностьРуководителяОрганизации",  НСтр("ru = 'Должность руководителя организации'"),          "Организация");

	ДобавитьПараметр(Параметры, "КонтрагентПередающий",                          НСтр("ru = 'Передающий (кратко)'"),                    "Передающий");
	ДобавитьПараметр(Параметры, "ПолноеНаименованиеКонтрагентаПередающего",      НСтр("ru = 'Передающий (полное наименование)'"),       "Передающий");
	ДобавитьПараметр(Параметры, "ИННКонтрагентаПередающего",                     НСтр("ru = 'ИНН передающего'"),                        "Передающий");
	ДобавитьПараметр(Параметры, "КППКонтрагентаПередающего",                     НСтр("ru = 'КПП передающего'"),                        "Передающий");
	ДобавитьПараметр(Параметры, "ОГРНКонтрагентаПередающего",                    НСтр("ru = 'ОГРН передающего'"),                       "Передающий");
	ДобавитьПараметр(Параметры, "ЮридическийАдресКонтрагентаПередающего",        НСтр("ru = 'Юридический адрес передающего'"),          "Передающий");
	ДобавитьПараметр(Параметры, "ТелефонКонтрагентаПередающего",                 НСтр("ru = 'Телефон передающего'"),                    "Передающий");
	ДобавитьПараметр(Параметры, "РуководительКонтрагентаПередающего",            НСтр("ru = 'Руководитель передающего'"),               "Передающий");
