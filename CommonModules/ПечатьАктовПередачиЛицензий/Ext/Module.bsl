// Добавляет строку в таблицу параметров шаблона.
Процедура ДобавитьПараметр(Параметры, Имя, Представление, Группа)

	Строка = Параметры.Добавить();
	Строка.Имя = Имя;
	Строка.Представление = Представление;
	Строка.Группа = Группа;

КонецПроцедуры

