// Клиентские процедуры печати актов приема-передачи лицензий по шаблонам
// из справочника ШаблоныПередачиЛицензий.

#Область ПрограммныйИнтерфейс

// Обработчик команды печати для механизма ПодключаемыеКоманды
// (см. Документ.ПередачаЛицензий.ДобавитьКомандыПечати).
//
// Параметры:
//   ОписаниеКоманды - Структура - см. ПодключаемыеКомандыКлиент.ВыполнитьКоманду
//
Процедура ВыполнитьКомандуПечати(ОписаниеКоманды) Экспорт

	Если ОписаниеКоманды.ОбъектыПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПечатьАкта(ОписаниеКоманды.ОбъектыПечати[0]);

КонецПроцедуры

// Открывает выбор шаблона акта, затем форму печатного текста акта.
//
// Параметры:
//   СсылкаНаОбъект - ДокументСсылка.ПередачаЛицензий - печатаемый документ
//
Процедура ПечатьАкта(СсылкаНаОбъект) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документ должен быть записан перед печатью акта.'"));
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыборШаблонаАктаЗавершение", ПечатьАктовПередачиЛицензийКлиент, СсылкаНаОбъект);

	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.ШаблоныПередачиЛицензий.ФормаВыбора",
		ПараметрыФормы, , , , , ОписаниеОповещения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

Процедура ВыборШаблонаАктаЗавершение(РезультатВыбора, СсылкаНаОбъект) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ОбъектПечати, ШаблонАкта", СсылкаНаОбъект, РезультатВыбора);
	ОткрытьФорму("Документ.ПередачаЛицензий.ФормаТекстаАкта", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти
