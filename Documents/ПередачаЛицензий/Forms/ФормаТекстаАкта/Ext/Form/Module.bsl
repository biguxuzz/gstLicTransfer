// Форма печатного текста акта приема-передачи лицензий.
// При создании заполняет форматированный документ по шаблону
// из справочника ШаблоныПередачиЛицензий.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("ОбъектПечати")
		Или Не ЗначениеЗаполнено(Параметры.ОбъектПечати) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ОбъектПечати = Параметры.ОбъектПечати;
	Если Параметры.Свойство("ШаблонАкта") Тогда
		ШаблонАкта = Параметры.ШаблонАкта;
	КонецЕсли;

	Заголовок = Строка(ОбъектПечати);

	ПараметрыЗаполнения = ПечатьАктовПередачиЛицензий.СтруктураПараметровПечатиАкта();
	ПараметрыЗаполнения.СсылкаНаОбъект = ОбъектПечати;
	ПараметрыЗаполнения.ШаблонАкта = ШаблонАкта;

	ПечатьАктовПередачиЛицензий.ЗаполнитьТекстАкта(ПараметрыЗаполнения, ФорматированныйДокумент);

КонецПроцедуры

#КонецОбласти
