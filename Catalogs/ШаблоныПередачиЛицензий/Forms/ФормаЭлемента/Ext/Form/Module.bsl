#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Заполняем список макетов-прототипов из метаданных справочника.
	Для Каждого МетаМакета Из Метаданные.Справочники.ШаблоныПередачиЛицензий.Макеты Цикл
		ЭлементСписка = СписокМакетов.Добавить();
		ЭлементСписка.Значение   = МетаМакета.Имя;
		ЭлементСписка.Представление = МетаМакета.Синоним;
	КонецЦикла;

	// Последней строкой - создание пустого шаблона.
	ЭлементСписка = СписокМакетов.Добавить();
	ЭлементСписка.Значение   = "";
	ЭлементСписка.Представление = НСтр("ru = 'Новый шаблон (без типового макета)'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокМакетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьШаблон(ИмяМакетаПоСтроке(ВыбраннаяСтрока));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьШаблонПоКнопке(Команда)

	ИмяМакета = ИмяМакетаПоСтроке(Элементы.СписокМакетов.ТекущаяСтрока);

	Если ИмяМакета = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите типовой шаблон из списка.'"));
		Возврат;
	КонецЕсли;

	ОткрытьШаблон(ИмяМакета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит строку списка макетов к имени макета.
// Для таблицы со списком значений ТекущаяСтрока возвращает значение элемента (строку),
// а в событии "Выбор" может прийти элемент списка значений - учитываем оба варианта.
//
// Параметры:
//   СтрокаСписка - Строка, ЭлементСписокЗначений, Неопределено
//
// Возвращаемое значение:
//   Строка - имя макета (пустая строка - новый шаблон без макета)
//   Неопределено - строка не выбрана
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяМакетаПоСтроке(Знач СтрокаСписка)

	Если СтрокаСписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(СтрокаСписка) = Тип("Строка") Тогда
		Возврат СтрокаСписка;
	КонецЕсли;

	Возврат СтрокаСписка.Значение;

КонецФункции

&НаКлиенте
Процедура ОткрытьШаблон(ИмяМакета)

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", Новый Структура("ИмяМакета", ИмяМакета));
	Если ЗначениеЗаполнено(ВладелецФормы) Тогда
		ПараметрыОткрытия.Вставить("Основание", ВладелецФормы);
	КонецЕсли;

	Закрыть();
	ОткрытьФорму("Справочник.ШаблоныПередачиЛицензий.ФормаРедактированияШаблона",
		ПараметрыОткрытия);

КонецПроцедуры

#КонецОбласти
